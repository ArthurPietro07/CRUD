<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= title || 'Usuários' %></h1>
    <% if (usuario && usuario.role === 'admin') { %>
        <a href="/users/new" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Novo Usuário
        </a>
    <% } %>
</div>

<!-- Barra de busca -->
<form action="/users/search" method="GET" class="mb-4">
    <div class="input-group">
        <input type="text" name="search" class="form-control" placeholder="Buscar usuário..." value="<%= search || '' %>">
        <button class="btn btn-outline-secondary" type="submit">
            <i class="bi bi-search"></i> Buscar
        </button>
        <% if (search) { %>
            <a href="/users" class="btn btn-outline-danger">Limpar</a>
        <% } %>
    </div>
</form>

<!-- Lista de usuários -->
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Usuário</th>
                <th>Função</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (users && users.length > 0) { %>
                <% users.forEach(user => { %>
                    <tr>
                        <td><%= user.id %></td>
                        <td><%= user.username %></td>
                        <td>
                            <span class="badge <%= user.role === 'admin' ? 'bg-danger' : 'bg-info' %>">
                                <%= user.role %>
                            </span>
                        </td>
                        <td>
                            <a href="/users/<%= user.id %>" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                            
                            <% if (usuario && usuario.role === 'admin') { %>
                                <a href="/users/<%= user.id %>/edit" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="/users/<%= user.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Tem certeza que deseja deletar este usuário?')">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4" class="text-center">Nenhum usuário encontrado</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Informações adicionais -->
<div class="mt-3">
    <small class="text-muted">
        Total de usuários: <%= users ? users.length : 0 %>
        <% if (usuario && usuario.role === 'admin') { %>
            <span class="ms-3 text-success">
                <i class="bi bi-info-circle"></i> Você tem permissões de administrador
            </span>
        <% } else { %>
            <span class="ms-3 text-warning">
                <i class="bi bi-info-circle"></i> Você está em modo somente leitura
            </span>
        <% } %>
    </small>
</div>